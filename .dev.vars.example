# Optional: Base URL for Cloudflare R2 / CDN hosting Supertonic 3 KRV MP3 files
# Generated via `bun run audio:generate-krv`; expects files at {AUDIO_BASE_URL}/{USFM}/{CHAPTER}.mp3
# AUDIO_BASE_URL=

# Optional: Free non-commercial Crossway ESV API key (https://api.esv.org/)
# Used for chapter-level English ESV audio playback (David Cochran Heath).
# ESV_API_KEY=
