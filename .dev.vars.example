# Local development defaults (copy to `.dev.vars`, gitignored).
# Shell environment variables always take precedence over values in `.dev.vars`.

# Optional external-CDN fallback for Supertonic 3 KRV MP3 files ({AUDIO_BASE_URL}/{USFM}/{CHAPTER}.mp3).
# Not needed when using the private R2 binding (`AUDIO_BUCKET` in wrangler.json) or local `.cache/krv-supertonic-audio/`.
# AUDIO_BASE_URL=

# Required in production (`wrangler secret put ESV_API_KEY`) and for live local ESV testing (`USE_LIVE_ESV=1 bun run dev`):
# Free non-commercial Crossway ESV API key (https://api.esv.org/)
# Used for live ESV chapter text (/api/esv/:usfm/:chapter) and English audio playback (David Cochran Heath).
# ESV_API_KEY=

# Optional Thunder Compute (`tnr` CLI) & SSH offload defaults for `bun run audio:generate-krv:remote`
# THUNDER_INSTANCE=0
# THUNDER_SSH_TARGET=tnr-0
# THUNDER_SSH_PORT=
# THUNDER_SSH_KEY=~/.ssh/id_ed25519
# THUNDER_REMOTE_DIR=~/logos2rhema-krv-tts
# THUNDER_DEVICE=auto
# Provisioning defaults when `--create` is used (already saved as code defaults in scripts/lib/remote-tts.ts):
# THUNDER_MODE=prototyping
# THUNDER_GPU=a6000
# THUNDER_NUM_GPUS=1
# THUNDER_VCPUS=8
# THUNDER_TEMPLATE=cuda12-8
# THUNDER_DISK_SIZE_GB=100
