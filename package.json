{
	"name": "logos",
	"description": "Bilingual English (ESV) & Korean (개역한글) Bible reader for learning Korean",
	"dependencies": {
		"hono": "4.13.19",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@types/bun": "1.4.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"happy-dom": "21.0.4",
		"wrangler": "4.166.0"
	},
	"private": true,
	"scripts": {
		"audio:generate-krv": "uv run scripts/generate-krv-audio.py",
		"audio:upload-krv": "bun run scripts/upload-krv-audio.ts",
		"build": "bun check -b --no-script && bun run scripts/build-client.ts",
		"check": "bun fmt --check --no-script && bun check -b --no-script",
		"data:build": "bun run scripts/build-bible-data.ts",
		"deploy": "wrangler deploy",
		"dev": "bun --hot scripts/dev-server.ts",
		"format": "bun fmt --no-script",
		"preview": "bun run build && bun run scripts/dev-server.ts --preview",
		"test": "bun test"
	},
	"type": "module"
}
