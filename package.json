{
	"name": "logos",
	"description": "Bilingual English (ESV) & Korean (개역한글) Bible reader for learning Korean",
	"dependencies": {
		"hono": "4.11.1",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@types/bun": "1.4.4",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"happy-dom": "17.6.3",
		"vite": "7.3.8",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"audio:align-krv": "uv run scripts/align-krv-audio.py",
		"build": "bun check -b --no-script && vite build",
		"check": "bun fmt --check --no-script && bun check -b --no-script",
		"data:build": "bun run scripts/build-bible-data.ts",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"format": "bun fmt --no-script",
		"preview": "bun run build && vite preview",
		"test": "bun test"
	},
	"type": "module"
}
