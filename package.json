{
	"name": "logos",
	"description": "Bilingual English (ESV) & Korean (개역한글) Bible reader for learning Korean",
	"dependencies": {
		"hono": "4.11.1",
		"lucide-react": "^0.553.0",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@cloudflare/vite-plugin": "1.52.1",
		"@happy-dom/global-registrator": "^21.0.4",
		"@testing-library/react": "^16.3.0",
		"@types/bun": "latest",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"happy-dom": "^17.4.4",
		"typescript": "5.9.3",
		"vite": "^7.0.0",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "biome check . && tsc -b",
		"data:build": "bun run scripts/build-bible-data.ts",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"preview": "bun run build && vite preview",
		"test": "bun test"
	},
	"type": "module"
}
